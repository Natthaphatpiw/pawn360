# Public application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Upstash Redis / Vercel KV
KV_REST_API_URL=https://YOUR_DATABASE.upstash.io
KV_REST_API_TOKEN=your_upstash_token
KV_REST_API_READ_ONLY_TOKEN=your_upstash_read_only_token
# The code also accepts the newer Upstash integration aliases. Configure one
# complete pair only; do not mix a URL from one database with another token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Queues and legacy dispatch fallback
JOB_DISPATCHER=vercel
JOB_WORKER_SECRET=generate_a_long_random_secret
JOB_CALLBACK_BASE_URL=https://your-production-domain.example
ESTIMATE_JOB_CALLBACK_BASE_URL=https://your-production-domain.example
QSTASH_TOKEN=
CRON_SECRET=generate_a_long_random_secret
INTERNAL_API_SECRET=generate_a_different_long_random_secret
JOB_CONCURRENCY_ESTIMATE_GENERIC=6
JOB_CONCURRENCY_ESTIMATE_NOTEBOOK=2
JOB_CONCURRENCY_CONDITION=8
JOB_RATE_LIMIT_ESTIMATE_PER_10_MIN=12
JOB_RATE_LIMIT_ESTIMATE_PER_DAY=60
JOB_RATE_LIMIT_CONDITION_PER_10_MIN=24
JOB_RATE_LIMIT_CONDITION_PER_DAY=120

# Distributed provider admission control. These are conservative application
# ceilings (not provider-plan claims); tune them below the quotas shown in each
# provider dashboard. Production fails closed when Redis is unavailable.
PROVIDER_CAPACITY_FAIL_CLOSED=true
PROVIDER_CAPACITY_OPENAI_RPM=240
PROVIDER_CAPACITY_OPENAI_TPM=1000000
PROVIDER_CAPACITY_OPENAI_CONCURRENCY=16
PROVIDER_CAPACITY_ANTHROPIC_RPM=120
PROVIDER_CAPACITY_ANTHROPIC_TPM=500000
PROVIDER_CAPACITY_ANTHROPIC_CONCURRENCY=8
PROVIDER_CAPACITY_PARALLEL_RPM=120
PROVIDER_CAPACITY_PARALLEL_CONCURRENCY=12
PROVIDER_CAPACITY_EXA_RPM=120
PROVIDER_CAPACITY_EXA_CONCURRENCY=8
PROVIDER_CAPACITY_SERPAPI_RPM=120
PROVIDER_CAPACITY_SERPAPI_CONCURRENCY=12
# Optional model override example:
# PROVIDER_CAPACITY_OPENAI_GPT_5_6_TERRA_CONCURRENCY=4

# OpenAI primary; Anthropic is the emergency model fallback
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=90000
# Privacy default: Responses are not retained by OpenAI application state.
OPENAI_STORE_RESPONSES=false
# Low-cost production defaults. Individual high-risk calls may escalate one level.
OPENAI_LUNA_REASONING_EFFORT=low
OPENAI_TERRA_REASONING_EFFORT=low
OPENAI_NOTEBOOK_REASONING_EFFORT=low
# Optional per-task overrides. Defaults in code are none/low first and at most
# one low/medium quality retry; leave unset until an evaluation justifies them.
# OPENAI_EFFORT_CONDITION_IMAGE_PRECHECK=none
# OPENAI_EFFORT_CONDITION_SCORING=low
# OPENAI_EFFORT_NOTEBOOK_VISION_SPEC=none
# OPENAI_EFFORT_SLIP_VERIFICATION=low
# OPENAI_EFFORT_GENERIC_NORMALIZE_INPUT=none
# OPENAI_EFFORT_NOTEBOOK_NORMALIZE_INPUT=none
# OPENAI_EFFORT_GENERIC_SERPAPI_FILTER=none
# OPENAI_EFFORT_NOTEBOOK_SERPAPI_FILTER=low
# OPENAI_EFFORT_NOTEBOOK_CANONICAL_SPEC=low
# OPENAI_EFFORT_GENERIC_MARKET_EXTRACT=low
# OPENAI_EFFORT_NOTEBOOK_MARKET_EXTRACT=low
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=
ANTHROPIC_API_KEY_4=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=120000

# Market search: Parallel primary, Exa fallback, SerpAPI optional independent source
PARALLEL_API_KEY=your_parallel_api_key
PARALLEL_SEARCH_MODE=turbo
PARALLEL_SEARCH_MAX_RESULTS=10
PARALLEL_SEARCH_TIMEOUT_MS=12000
EXA_API_KEY=your_exa_api_key
EXA_SEARCH_MAX_RESULTS=5
EXA_SEARCH_TIMEOUT_MS=30000
EXA_SEARCH_MAX_RESPONSE_BYTES=2097152
MARKET_SEARCH_CACHE_TTL_SECONDS=21600
MARKET_SEARCH_STALE_TTL_SECONDS=604800
MARKET_SEARCH_MAX_EXCERPT_CHARS_PER_RESULT=2500
MARKET_SEARCH_SINGLEFLIGHT_LOCK_MS=60000
MARKET_SEARCH_SINGLEFLIGHT_WAIT_MS=10000
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_EXCHANGE_RATE_THB_PER_USD=32
# Set from the active SerpAPI plan; used for pre-call budget reservation.
SERPAPI_COST_PER_SEARCH_USD=0.02
SERPAPI_TIMEOUT_MS=15000

# AI cache, safety and cost controls
ESTIMATE_CACHE_TTL_SECONDS=43200
ESTIMATE_IMAGE_HASH_CACHE_TTL_SECONDS=2592000
MARKET_PRICE_EXTRACTION_CACHE_TTL_SECONDS=43200
# Images referenced by an AI job must resolve to this project's own private
# Blob store. Leave unset to derive the allowlist from BLOB_STORE_ID.
# ESTIMATE_IMAGE_ALLOWED_HOSTS=
ESTIMATE_IMAGE_FETCH_TIMEOUT_MS=15000
# Local-only performance escape hatch; production ignores client image hashes.
ALLOW_CLIENT_IMAGE_HASHES=false
AI_USAGE_TTL_SECONDS=7776000
AI_MONTHLY_BUDGET_USD=500
AI_MAX_JOB_COST_USD=1
# Backstop against a runaway or abusive account - NOT the everyday limit. The
# product rule is JOB_RATE_LIMIT_ESTIMATE_PER_DAY (60 estimates/user/day); at a
# measured ~$0.035 per estimate, $2 caps a user at ~56 and therefore fires
# BEFORE the count limit, so a normal heavy user hits an opaque budget error
# instead of a clear "too many requests". Keep this above 60 estimates' worth,
# with headroom for the pricier notebook path (~$0.069 worst case).
AI_MAX_OWNER_DAILY_COST_USD=5
AI_SAFETY_IDENTIFIER_SECRET=generate_a_long_random_secret
RATE_LIMIT_IDENTIFIER_SECRET=generate_a_different_long_random_secret
ALLOW_SYNCHRONOUS_AI_ROUTES=false

# A server-signed estimate is required before a loan request may trust a price.
ESTIMATE_ATTESTATION_SECRET=generate_at_least_32_random_bytes
ESTIMATE_ATTESTATION_TTL_SECONDS=43200
MIN_ESTIMATE_CONFIDENCE_FOR_SUBMISSION=0.5

# UpPass eKYC. Configure distinct secrets/forms for each role.
UPPASS_API_URL=https://app.uppass.io
UPPASS_API_URL_INVEST=https://app.uppass.io
UPPASS_FORM_SLUG=your_seller_form_slug
UPPASS_FORM_SLUG_INVEST=your_asset_funding_form_slug
UPPASS_API_KEY=your_uppass_api_key
UPPASS_API_KEY_INVEST=your_uppass_invest_api_key
# UpPass documents Basic Auth for webhooks. Configure independent credentials
# for Seller and Asset Funding callbacks and never put them in a browser bundle.
UPPASS_WEBHOOK_AUTH_MODE=basic
UPPASS_WEBHOOK_BASIC_USERNAME=your_seller_webhook_username
UPPASS_WEBHOOK_BASIC_PASSWORD=generate_a_long_random_password
UPPASS_WEBHOOK_AUTH_MODE_INVEST=basic
UPPASS_WEBHOOK_BASIC_USERNAME_INVEST=your_asset_funding_webhook_username
UPPASS_WEBHOOK_BASIC_PASSWORD_INVEST=generate_a_different_long_random_password
UPPASS_ALLOWED_HOSTS=app.uppass.io,api.uppass.io
UPPASS_FORM_ALLOWED_HOSTS=app.uppass.io
UPPASS_FORM_ALLOWED_HOSTS_INVEST=app.uppass.io
UPPASS_ALLOW_LEGACY_ACCEPTED=false
# Legacy HMAC is opt-in only when explicitly agreed with UpPass.
# UPPASS_WEBHOOK_AUTH_MODE=legacy_hmac
# UPPASS_WEBHOOK_SECRET=generate_a_long_random_webhook_secret
# UPPASS_WEBHOOK_AUTH_MODE_INVEST=legacy_hmac
# UPPASS_WEBHOOK_SECRET_INVEST=generate_a_different_long_random_webhook_secret
UPPASS_REQUEST_TIMEOUT_MS=12000
# Global application-side UpPass admission limits. Keep these below the
# provider-plan quota; all instances share the counters through Redis.
UPPASS_GLOBAL_WINDOW_SECONDS=60
UPPASS_GLOBAL_REQUEST_LIMIT=30
UPPASS_GLOBAL_CONCURRENCY_LIMIT=4

# LINE server credentials
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN_INVEST=your_invest_line_access_token
LINE_CHANNEL_SECRET_INVEST=your_invest_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN_DROPPOINT=your_droppoint_line_access_token
LINE_CHANNEL_SECRET_DROPPOINT=your_droppoint_line_channel_secret
LINE_STORE_CHANNEL_ACCESS_TOKEN=your_store_line_access_token
LINE_STORE_CHANNEL_SECRET=your_store_line_channel_secret
# Only enable during a controlled migration when Store OA intentionally shares
# the Seller channel. Production should normally keep this false.
LINE_STORE_ALLOW_SHARED_CHANNEL=false
LINE_LOGIN_CHANNEL_ID=your_seller_line_login_channel_id
LINE_LOGIN_CHANNEL_ID_INVEST=your_invest_line_login_channel_id
LINE_LOGIN_CHANNEL_ID_STORE=your_store_line_login_channel_id
LINE_LOGIN_CHANNEL_ID_DROPPOINT=your_droppoint_line_login_channel_id
LINE_LOGIN_CHANNEL_ID_ADMIN=your_admin_line_login_channel_id
ADMIN_LINE_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LIFF IDs are public identifiers, not secrets
NEXT_PUBLIC_LIFF_ID=your_liff_id
NEXT_PUBLIC_LIFF_ID_REGISTER=your_liff_id
NEXT_PUBLIC_LIFF_ID_PAWN=your_liff_id
NEXT_PUBLIC_LIFF_ID_CONTRACTS=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVEST=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVESTMENT=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVEST_REGISTER=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVEST_DASHBOARD=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVEST_PAYMENT=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVESTOR_OFFERS=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVEST_OFFER_DETAIL=your_liff_id
NEXT_PUBLIC_LIFF_ID_INVEST_PRINCIPAL_INCREASE=your_liff_id
NEXT_PUBLIC_LIFF_ID_STORE=your_liff_id
NEXT_PUBLIC_LIFF_ID_DROPPOINT=your_liff_id
NEXT_PUBLIC_LIFF_ID_DROPPOINT_LIST=your_liff_id
NEXT_PUBLIC_LIFF_ID_DROPPOINT_PICKUP=your_liff_id
NEXT_PUBLIC_LIFF_ID_ADMIN_ESTIMATE=your_liff_id

# Slip verification
# SLIPOK_BRANCH_ID is the NUMERIC branch id from the SlipOK dashboard - it is
# what the request URL is built from. Setting SLIPOK_API_URL to the bare host
# used to be read as the branch id and produced an unusable request URL; a
# non-numeric value is now ignored, so SlipOK stays off until the real id is
# set. Both the branch id and the key must be present or every payment slip
# falls back to the vision model, which cannot detect a forged or reused slip.
SLIPOK_API_URL=https://api.slipok.com/api/line/apikey/<numeric-branch-id>
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
SLIPOK_PASSWORD=
SLIPOK_REQUEST_TIMEOUT_MS=15000
SLIP_IMAGE_FETCH_TIMEOUT_MS=8000
# AI can read an amount when SlipOK is unavailable, but must not automatically
# authorize a financial state transition because it cannot prove authenticity.
AI_SLIP_MIN_CONFIDENCE=0.85
ALLOW_AI_SLIP_AUTO_APPROVAL=false

# Storage and legacy integrations
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
BLOB_STORE_ID=your_blob_store_id
BLOB_WEBHOOK_PUBLIC_KEY=your_blob_webhook_public_key
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
MONGODB_DB=pawn
SHOP_SYSTEM_URL=https://your-shop-system.example
SHOP_SYSTEM_API_TOKEN=generate_a_long_random_bearer_token
WEBHOOK_SECRET=generate_a_long_random_secret
SHOP_WEBHOOK_SIGNATURE_MODE=body-hmac-v2
SHOP_WEBHOOK_ALLOW_LEGACY_HMAC=false
RICH_MENU_ID_MEMBER=your_rich_menu_id

# Local-only switches (never enable mocks in production)
NEXT_PUBLIC_LIFF_MOCK=false
NEXT_PUBLIC_DROPPOINT_MOCK=false
MANUAL_ESTIMATE_ENABLED=false
