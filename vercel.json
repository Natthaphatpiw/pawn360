          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queues/estimate-notebook/route.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "pawnline-estimate-notebook-v1",
          "retryAfterSeconds": 45,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queues/analyze-condition/route.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "pawnline-condition-v1",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queues/process-ekyc-webhook/route.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
